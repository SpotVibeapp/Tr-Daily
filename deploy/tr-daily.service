[Unit]
Description=Tr-Daily 24/7 Autonomous Day-Trading Service
After=network.target

[Service]
Type=simple
User=trdaily
WorkingDirectory=/opt/tr-daily
ExecStart=/usr/bin/dart run bin/tr_daily_server.dart
Restart=always
RestartSec=10
EnvironmentFile=/etc/tr-daily/tr-daily.env

# Sandboxing & Security
ProtectSystem=full
ProtectHome=read-only
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
